@page "/"
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.SignalR.Client
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration
@implements IAsyncDisposable

<PageTitle>StreamSharp - Downloader</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-10">
    <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true" Color="Color.Primary" Class="fw-bold">
        StreamSharp Downloader
    </MudText>

    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-8 text-secondary">
        Baixe vídeos e transmissões em tempo real com alta performance.
    </MudText>

    <MudPaper Class="pa-6 elevation-6 rounded-lg">
        <EditForm Model="@downloadModel" OnValidSubmit="InitiateDownload">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="downloadModel.Url"
                          Label="URL do Vídeo"
                          Variant="Variant.Outlined"
                          Placeholder="Cole o link do vídeo ou iframe aqui..."
                          Disabled="isProcessing"
                          For="@(() => downloadModel.Url)"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Link" />

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="mt-4 py-3"
                       Size="Size.Large"
                       Disabled="isProcessing">
                @if (isProcessing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Processando Requisição...</MudText>
                }
                else
                {
                    <MudText>Iniciar Download</MudText>
                }
            </MudButton>
        </EditForm>

        @if (currentJob is not null)
        {
            <MudCard Class="mt-6 pa-5 border-solid border-2 mud-border-primary rounded-lg elevation-2">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.body1">
                        <b>Status:</b> @statusMessage
                    </MudText>
                    <MudChip T="string" Color="@GetStatusColor(currentJob.Status)" Size="Size.Small" Variant="Variant.Filled">
                        @currentJob.Status
                    </MudChip>
                </div>

                <!-- Barra de Progresso MudBlazor -->
                <MudProgressLinear Color="@GetProgressColor(currentJob.Status)"
                                   Value="currentJob.Progress"
                                   Size="Size.Large"
                                   Striped="true"
                                   Class="my-3 rounded">
                    <MudText Typo="Typo.caption" Color="Color.Dark">
                        <b>@currentJob.Progress.ToString("F1")%</b>
                    </MudText>
                </MudProgressLinear>

                @if (!string.IsNullOrEmpty(currentJob.ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3">
                        @currentJob.ErrorMessage
                    </MudAlert>
                }
            </MudCard>
        }
    </MudPaper>
</MudContainer>

@code {
    private DownloadModel downloadModel = new();
    private JobState? currentJob;
    private bool isProcessing = false;
    private string statusMessage = "Aguardando...";
    private HubConnection? hubConnection;
    private string ApiBaseUrl => Configuration["ApiBaseUrl"]!;
    private HttpClient ApiClient => HttpClientFactory.CreateClient("StreamSharpApi");
    protected override async Task OnInitializedAsync()
    {
        // 1. Configura a conexão do SignalR com Reconexão Automática
        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{ApiBaseUrl}/hubs/download")
            .WithAutomaticReconnect()
            .Build();

        // 2. Registra o ouvinte de progresso enviado pelo Hub
        hubConnection.On<string, double, string>("ReceiveProgress", (jobId, percent, message) =>
        {
            if (currentJob?.JobId == jobId)
            {
                currentJob.Progress = percent;
                currentJob.Status = "Downloading";
                statusMessage = string.IsNullOrWhiteSpace(message) ? $"{percent:F1}% concluído" : message;
                StateHasChanged();
            }
        });

        // 3. Registra o ouvinte de conclusão do download
        hubConnection.On<string>("DownloadCompleted", async (jobId) =>
        {
            if (currentJob?.JobId == jobId)
            {
                currentJob.Progress = 100;
                currentJob.Status = "Completed";
                statusMessage = "Download concluído! Iniciando transferência...";
                isProcessing = false;
                StateHasChanged();

                // Dispara o download nativo do navegador para o arquivo .mp4 gerado
                string downloadUrl = $"{ApiBaseUrl}/api/video/stream-file/{jobId}";
                await JS.InvokeVoidAsync("open", downloadUrl, "_self");
            }
        });

        // 4. Registra o ouvinte para falhas/erros
        hubConnection.On<string, string>("DownloadFailed", (jobId, error) =>
        {
            if (currentJob?.JobId == jobId)
            {
                currentJob.Status = "Failed";
                currentJob.ErrorMessage = error;
                statusMessage = "O download falhou.";
                isProcessing = false;
                StateHasChanged();
            }
        });

        await hubConnection.StartAsync();
    }

    private async Task InitiateDownload()
    {
        if (string.IsNullOrWhiteSpace(downloadModel.Url)) return;

        isProcessing = true;
        statusMessage = "Enviando requisição...";

        try
        {
            // Envia o POST /api/video/download para passar pelo RateLimiter e criar o Job
            var response = await ApiClient.PostAsJsonAsync("api/video/download", downloadModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<EnqueueResponse>();

                if (result is not null)
                {
                    currentJob = new JobState
                    {
                        JobId = result.JobId,
                        Progress = 0,
                        Status = "Queued"
                    };

                    statusMessage = result.Message;

                    // Registra o cliente no Grupo do SignalR referente ao JobId para receber notificações ativas
                    if (hubConnection is not null && hubConnection.State == HubConnectionState.Connected)
                    {
                        await hubConnection.SendAsync("SubscribeToJob", result.JobId);
                    }
                }
            }
            else if ((int)response.StatusCode == 429)
            {
                statusMessage = "Servidor ocupado. A fila de downloads está cheia. Tente novamente em alguns instantes.";
                isProcessing = false;
            }
            else
            {
                var errorProblem = await response.Content.ReadFromJsonAsync<ProblemDetailsDto>();
                statusMessage = errorProblem?.Detail ?? "Erro ao iniciar a requisição de download.";
                isProcessing = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Erro de conexão: {ex.Message}";
            isProcessing = false;
        }

        StateHasChanged();
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Queued" => Color.Warning,
        "Downloading" => Color.Info,
        "Completed" => Color.Success,
        "Failed" => Color.Error,
        _ => Color.Default
    };

    private Color GetProgressColor(string status) => status switch
    {
        "Completed" => Color.Success,
        "Failed" => Color.Error,
        _ => Color.Info
    };

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    // Modelos de Suporte e DTOs
    public class DownloadModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A URL é obrigatória.")]
        [System.ComponentModel.DataAnnotations.Url(ErrorMessage = "Insira uma URL válida.")]
        public string Url { get; set; } = string.Empty;
    }

    public class EnqueueResponse
    {
        [JsonPropertyName("jobId")]
        public string JobId { get; set; } = string.Empty;

        [JsonPropertyName("message")]
        public string Message { get; set; } = string.Empty;

        [JsonPropertyName("statusUrl")]
        public string StatusUrl { get; set; } = string.Empty;

        [JsonPropertyName("downloadUrl")]
        public string DownloadUrl { get; set; } = string.Empty;
    }

    public class JobState
    {
        public string JobId { get; set; } = string.Empty;
        public double Progress { get; set; }
        public string Status { get; set; } = "Queued";
        public string? ErrorMessage { get; set; }
    }

    public class ProblemDetailsDto
    {
        [JsonPropertyName("title")]
        public string? Title { get; set; }

        [JsonPropertyName("detail")]
        public string? Detail { get; set; }
    }
}